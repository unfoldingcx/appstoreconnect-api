{
  "name": "@unfoldingcx/appstoreconnect-api",
  "version": "1.2.5",
  "description": "A powerful TypeScript library for automating Apple App Store Connect submissions with AI-powered release notes generation, intelligent error handling, and automatic retry mechanisms",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "private": false,
  "bin": {
    "asca": "./dist/cli.js",
    "appstoreconnect-api": "./dist/cli.js"
  },
  "keywords": [
    "apple",
    "app-store",
    "app-store-connect",
    "ios",
    "macos",
    "tvos",
    "automation",
    "ci-cd",
    "review",
    "submission",
    "testflight",
    "typescript",
    "ai",
    "openai",
    "release-notes",
    "changelog",
    "git",
    "cli",
    "github-action",
    "github-actions"
  ],
  "author": "JOAO PEDRO BARBOSA VIANA <pitter@unfolding.cx>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unfoldingcx/appstoreconnect-api.git"
  },
  "bugs": {
    "url": "https://github.com/unfoldingcx/appstoreconnect-api/issues"
  },
  "homepage": "https://github.com/unfoldingcx/appstoreconnect-api#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "start": "node dist/index.js",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "lint:fix": "prettier --write \"{src}/**/*.{ts}\" && eslint \"{src}/**/*.{ts}\" --fix --quiet",
    "dev": "bun run src/index.ts",
    "cli": "bun run src/cli.ts",
    "test:cli": "bun run build && npm link && asca --help",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/bun": "latest",
    "@types/chalk": "^2.2.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "esbuild-plugin-ts-decorators": "^1.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-eqeqeq-fix": "^1.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.46.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "openai": "^6.8.1",
    "simple-git": "^3.30.0",
    "util": "^0.12.5"
  }
}
